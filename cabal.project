-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-06T16:46:26Z

packages:
  cardano-cli

program-options
  ghc-options: -Werror

package crypton
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package bitvec
  -- Workaround for windows cross-compilation
  flags: -simd

extra-packages: Cabal

if impl(ghc <9.14)
  constraints:
    -- Both providers export the same C clock symbol in static musl builds.
    -- DNS 4.2.0.1 shares the modern provider required by TLS.
    -- haskell.nix patch does not work for 1.6.8
    , hourglass < 0
    , dns ^>=4.2.0.1
    , any.crypton-x509-system (< 1.6.8 || >= 1.7)

if os(windows)
  constraints: time ^>=1.14
  allow-newer: *:time
  -- Needed for running tests with WINE (see https://github.com/haskell/network/issues/604)
  constraints: network <3.2.8.0
  -- cardano-config only uses PortNumber; it does not need the new 3.2.8
  -- socket options that break the WINE Template Haskell interpreter.
  -- kes-agent uses the existing raw-bearer/snocket interfaces, not those options.
  allow-older: cardano-config:network, kes-agent:network
-- cardano-ledger-binary 1.9.0.0 reversed the byte order of relay IPv4 addresses (cardano-cli#1442)
constraints: cardano-ledger-binary >=1.9.1

-- Depending on C++ for just so slightly faster utf8 parsing is a bit annoying
-- especially as it brings in all kinds of complications for GHC.
package text
  flags: -simdutf

-- formatting (>= 7.2) allows us do drop double-conversion (which again is one
-- of the offending c++ dependencies)
package formatting
  flags: +no-double-conversion

tests: True
test-show-details: direct
-- enable parallel builds
jobs: $ncpus
semaphore: True
-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about updating dependencies.
-- cabal-allow-newer begin
if impl(ghc >=9.14)
  allow-newer:
    , bytestring-trie:base
    , canonical-json:containers
    , cborg:base
    , cborg:containers
    , cborg-json:base
    , compact:base
    , dependent-map:containers
    , dictionary-sharing:containers
    , diff-containers:base
    , fs-sim:QuickCheck
    , grapesy:base
    , grapesy:containers
    , grapesy:tls
    , grpc-spec:base
    , grpc-spec:containers
    , lens-family:containers
    , lens-family-core:containers
    , lsm-tree:data-elevator
    , newtype-generics:base
    , ordered-containers:containers
    , partial-order:containers
    , safe-wild-cards:template-haskell
    , serdoc-core:template-haskell
    , serialise:base
    , serialise:containers
    , serialise:time
    , tdigest:base
    , time-locale-compat:time
    , with-utf8:base

-- cabal-allow-newer end
-- Temporary upstream DNS prerequisite: https://github.com/kazu-yamamoto/dns/pull/177
-- Share the modern time provider while retaining the static musl guard above.
source-repository-package
  type: git
  location: https://github.com/colll78/dns.git
  tag: 7bd4304298b38db3da0e72dec2b311f4cd785657
  --sha256: sha256-HRBHCYqk4Y63M81ry+qs7o6qtottda1RddK84lTSb/E=

