source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger
  tag: d37df81c04fee76b5206d426edc990ebd641b2a4
  --sha256: sha256-sfCMBZx0IujpIwkXgh7Ylu1d1O6WMqJ9S2LvJBG9RdI=
