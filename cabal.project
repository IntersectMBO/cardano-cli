repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-09-20T20:47:43Z
  , cardano-haskell-packages 2026-09-16T23:53:07Z

constraints:
  -- EXPERIMENT: force cardano-crypto-class up to the 2.6.x line (which
  -- requires crypton ^>=1.1). cardano-keys (CHaP, unmodified) pins
  -- cardano-crypto-class ^>=2.5, so its bound needs an allow-newer below too.
  , any.cardano-crypto-class ^>=2.6

  -- EXPERIMENT: cardano-crypto-1.2.0 (the version the solver reaches for
  -- otherwise) still uses the old `memory` package for ByteArrayAccess,
  -- which doesn't unify with crypton-1.1.4's `ram`-based Digest instances.
  -- cardano-crypto-1.4.0 (already in CHaP) has switched to ram >=0.22.
  , any.cardano-crypto >= 1.4

allow-newer:
  -- cardano-keys (CHaP 11.0.0.0, unmodified) pins cardano-crypto-class
  -- ^>=2.5 and cardano-crypto-wrapper ^>=1.7, and cardano-ledger-core
  -- ^>=1.21 / cardano-ledger-shelley ^>=1.19, all excluded by the versions
  -- the SRPs above now provide.
  , cardano-keys:cardano-crypto-class
  , cardano-keys:cardano-crypto-wrapper
  , cardano-keys:cardano-ledger-core
  , cardano-keys:cardano-ledger-shelley
  -- cardano-cli itself (this package) still pins cardano-crypto-class
  -- <2.6 and cardano-crypto-wrapper ^>=1.7 in its own .cabal file.
  , cardano-cli:cardano-crypto-class
  , cardano-cli:cardano-crypto-wrapper
  , kes-agent:cardano-crypto-class
  , kes-agent-crypto:cardano-crypto-class

-- TEMPORARY: ouroboros-consensus's SRP above doesn't keep its own version
-- field in sync with real numbered releases -- those are cut from separate
-- release branches -- so its version field is a permanently stale
-- placeholder. Bridge with allow-older instead of chasing a bump-and-push
-- fix each time.
allow-older:
  , cardano-cli:ouroboros-consensus

-- TEMPORARY: SRPs for the crypton >=1.1 migration, kept in sync with the
-- exact commits used by the cardano-api and ouroboros-consensus SRPs of the
-- same migration (cardano-api's erikd/crypton+ram branch, ouroboros-consensus
-- PR #2313 / erikd/update-ledger-srp) rather than independently-chosen
-- commits or CHaP releases -- none of these fixes are released yet, and the
-- code in each of these repos is written against these exact commits.
source-repository-package
  type: git
  location: https://github.com/input-output-hk/cardano-api
  tag: 0cc537ee37d1e35f974d6cd469d332295dd16eb1
  subdir:
    cardano-api
    cardano-rpc

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-consensus
  tag: 1fe3caa7cdc0db8449adc358eea6be84710a5eb6
