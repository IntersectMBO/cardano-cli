-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-13T14:57:01Z

packages:
  cardano-cli

program-options
  ghc-options: -Werror

package crypton
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package bitvec
  -- Workaround for windows cross-compilation
  flags: -simd

extra-packages: Cabal

if impl(ghc < 9.14)
  constraints:
    -- haskell.nix patch does not work for 1.6.8
    , any.crypton-x509-system (< 1.6.8 || >= 1.7)

if os(windows)
  constraints: time ^>=1.14
  allow-newer: *:time
  -- Needed for running tests with WINE (see https://github.com/haskell/network/issues/604)
  constraints: network <3.2.8.0
  -- cardano-config and kes-agent (pulled in by ouroboros-consensus 5.0 and
  -- cardano-api) require network ^>=3.2.8, but they only need APIs that are
  -- already in 3.2.7, so let them accept the WINE-compatible network pinned
  -- above.
  allow-older:
    , cardano-config:network
    , kes-agent:network

-- cardano-ledger-binary 1.9.0.0 reversed the byte order of relay IPv4 addresses (cardano-cli#1442)
constraints: cardano-ledger-binary >=1.9.1

-- Depending on C++ for just so slightly faster utf8 parsing is a bit annoying
-- especially as it brings in all kinds of complications for GHC.
package text
  flags: -simdutf

-- formatting (>= 7.2) allows us do drop double-conversion (which again is one
-- of the offending c++ dependencies)
package formatting
  flags: +no-double-conversion

tests: True
test-show-details: direct

-- enable parallel builds
jobs: $ncpus
semaphore: True

-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about updating dependencies.

-- Temporary pin for the Plutus data decoder fix in https://github.com/IntersectMBO/cardano-ledger/pull/6189
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger
  tag: a2041c4bd73995fb4ab3b90db03fdf8ff464e104
  --sha256: 0syndgsgzhzg1wk3k4lf4anfvv9wvvzf437wk8c890mlk4g69vjn
  subdir:
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/byron/crypto
    eras/byron/ledger/impl
    eras/conway/impl
    eras/dijkstra/impl
    eras/mary/impl
    eras/shelley/impl
    eras/shelley/test-suite
    libs/cardano-data
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/non-integral
    libs/small-steps
    libs/vector-map

-- cardano-api 11.9 uses guard and stake distribution accessors changed by the ledger SRP.
-- Keep this temporary substitution in sync with cardano-api.postPatch in flake.nix.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api
  tag: 79d1fd050d131127e3d976208d1654c8e097eee6
  --sha256: 009cbk7vjy07b1gg54rh3kxgh02s6513f51j8aa3lxmxp4rkx0j3
  subdir: cardano-api
  post-checkout-command: sh -ec "sed -i.bak s/requiredTopLevelGuardsL/requiredTopLevelGuardsTxBodyL/g cardano-api/src/Cardano/Api/Experimental/Tx/Internal/BodyContent.hs cardano-api/src/Cardano/Api/Experimental/Tx/Internal/SubTransaction.hs cardano-api/test/cardano-api-test/Test/Cardano/Api/Experimental.hs; sed -i.bak -e 's/^import Data.Aeson qualified as Aeson$/import Data.Aeson qualified as Aeson; import Lens.Micro ((^.))/' -e 's|^import Cardano.Ledger.Shelley.API qualified as Shelley$|import Cardano.Ledger.Shelley.API qualified as Shelley; import Cardano.Ledger.Shelley.LedgerState qualified as Shelley (nesStakePoolDistrG)|' -e 's/Shelley.nesPd newEpochS/newEpochS ^. Shelley.nesStakePoolDistrG/' cardano-api/src/Cardano/Api/Query/Internal/Type/DebugLedgerState.hs"

-- Adapt the released consensus package to the ledger's new stake distribution getter.
-- Keep these substitutions in sync with ouroboros-consensus.postPatch in flake.nix.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-consensus
  tag: 4ab9e25069c24be341fb96887a416443f822d01c
  --sha256: 01rgxx962d5vmdd4l69g0z5dxi51c21mj32406x9ldclmc6i9r5r
  post-checkout-command: sh -ec "sed -i.bak 's/nesPd \\./view SL.nesStakePoolDistrG ./g' ouroboros-consensus-cardano/src/shelley/Ouroboros/Consensus/Shelley/Ledger/Ledger.hs; sed -i.bak -e 's|^import qualified Cardano.Ledger.Shelley.API as SL$|import qualified Cardano.Ledger.Shelley.API as SL; import qualified Cardano.Ledger.Shelley.LedgerState as SL (nesStakePoolDistrG)|' -e 's/SL.NewEpochState{nesPd} = nes/nesPd = nes Lens.Micro.^. SL.nesStakePoolDistrG/' ouroboros-consensus-cardano/src/shelley/Ouroboros/Consensus/Shelley/Ledger/SupportsProtocol.hs; sed -i.bak -e 's/seedInitialStakeSnapshots maxKeyAge trigger/seedInitialStakeSnapshots _maxKeyAge trigger/' -e 's/mkSetSnapShot (ss ^. ssStakeMarkL) maxKeyAge/mkSetSnapShot (ss ^. ssStakeMarkL)/' ouroboros-consensus-cardano/src/ouroboros-consensus-cardano/Ouroboros/Consensus/Cardano/Node.hs"

allow-newer:
  -- Temporary ledger SRP versions exceed the bounds in these released packages.
  , cardano-api:cardano-ledger-api
  , cardano-api:cardano-protocol
  , cardano-config:cardano-ledger-alonzo
  , cardano-config:cardano-ledger-conway
  , cardano-config:cardano-ledger-core
  , cardano-config:cardano-ledger-dijkstra
  , cardano-config:cardano-ledger-shelley
  , cardano-keys:cardano-ledger-core
  , cardano-keys:cardano-ledger-shelley
  , cardano-keys:cardano-protocol
  , ouroboros-consensus:cardano-ledger-alonzo
  , ouroboros-consensus:cardano-ledger-api
  , ouroboros-consensus:cardano-ledger-conway
  , ouroboros-consensus:cardano-ledger-core
  , ouroboros-consensus:cardano-ledger-dijkstra
  , ouroboros-consensus:cardano-ledger-mary
  , ouroboros-consensus:cardano-ledger-shelley
  , ouroboros-consensus:cardano-protocol
  -- Allow network-mux 0.11 from SRP (cardano-ping 0.10 on CHaP expects ^>=0.10)
  , cardano-ping:network-mux
  -- Allow grapesy deps with updated bounds (matching cardano-node)
  , grapesy:aeson
  , grapesy:crypton-x509
  , grapesy:crypton-x509-store
  , grapesy:crypton-x509-system
  , grapesy:crypton-x509-validation
  , grapesy:http2
  , grapesy:http2-tls
  , grapesy:network-run
  , grapesy:tls
  -- kes-agent bounds cardano-crypto-class ^>=2.5 but we have a newer version
  , kes-agent:cardano-crypto-class
  , kes-agent-crypto:cardano-crypto-class

-- cabal-allow-newer begin
if impl(ghc >= 9.14)
  allow-newer:
    , bytestring-trie:base
    , canonical-json:containers
    , cborg:base
    , cborg:containers
    , cborg-json:base
    , compact:base
    , dependent-map:containers
    , dictionary-sharing:containers
    , diff-containers:base
    , fs-sim:QuickCheck
    , grapesy:base
    , grapesy:containers
    , grapesy:tls
    , grpc-spec:base
    , grpc-spec:containers
    , lens-family:containers
    , lens-family-core:containers
    , lsm-tree:data-elevator
    , ordered-containers:containers
    , partial-order:containers
    , safe-wild-cards:template-haskell
    , serdoc-core:template-haskell
    , serialise:base
    , serialise:containers
    , serialise:time
    , tdigest:base
    , time-locale-compat:time
    , with-utf8:base
-- cabal-allow-newer end
